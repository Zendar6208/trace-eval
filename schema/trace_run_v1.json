      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/RunSummary",
      "description": "Aggregated run results"
    },
    "system": {
      "anyOf": [
        {
          "$ref": "#/$defs/SystemMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Evaluated system metadata and provenance (never hashed)"
    }
  },
  "required": [
    "dataset",
    "submission_content_sha256",
    "config",
    "summary",
    "items"
