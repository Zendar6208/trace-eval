        "$ref": "#/$defs/RunItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "methodology_version": {
      "default": "1.0.0",
      "description": "Normative methodology version",
      "title": "Methodology Version",
      "type": "string"
    },
    "result_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deterministic SHA-256 hash of canonical run core",
      "title": "Result Hash"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "First 16 hexadecimal characters of result_hash",
      "title": "Run Id"
    },
    "runtime_status": {
      "anyOf": [
        {
          "enum": [
            "live",
